	<array><string>location</string><string>audio</string></array>
	<key>NSSupportsLiveActivities</key><true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key><true/>
	<key>CFBundleURLTypes</key>
	<array><dict>
		<key>CFBundleURLName</key><string>fr.osalabs.osamaps</string>
		<key>CFBundleURLSchemes</key><array><string>osamaps</string></array>
	</dict></array>
